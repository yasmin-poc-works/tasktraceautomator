# TaskTraceAutomator Environment Configuration

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-generate-a-secure-50-character-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# Database & Cache
DATABASE_URL=postgres://postgres:postgres@postgres:5432/tasktrace
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Artifacts & Storage
ARTIFACTS_DIR=/artifacts

# External Integrations
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# LLM Providers (for Analyst and Planner - Groq, Gemini free tier, or Ollama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Coding Agent Runner (Claude Code CLI / Fallback)
ANTHROPIC_API_KEY=

